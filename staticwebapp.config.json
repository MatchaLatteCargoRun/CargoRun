{
  "platform": {
    "apiRuntime": "node:22"
  },
  "routes": [
    {
      "route": "/signed-out.html",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/signed-out",
      "redirect": "/signed-out.html",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/mach-fow",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/*",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad"
    }
  }
}
